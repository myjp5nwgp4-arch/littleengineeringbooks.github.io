:root {
  --text-dark: #1a1a1a;
  --text-muted: #6b7280;
  --bg-light: #fafaf9;
  --bg-lighter: #f5f5f4;
  --border-light: #e5e7eb;
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
  --shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 20px 50px rgba(0, 0, 0, 0.12);
  --accent-orange: #F17C58;
  --accent-pink: #D946A6;
  --accent-teal: #06B6D4;
  --accent-blue: #3B82F6;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: "Work Sans", sans-serif;
  background: var(--bg-light);
  color: var(--text-dark);
  line-height: 1.6;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

.container {
  width: min(1200px, calc(100% - 2rem));
  margin: 0 auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: white;
  border-bottom: 1px solid var(--border-light);
  box-shadow: var(--shadow-sm);
}

.nav-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72px;
}

.brand {
  font-family: "Baloo 2", sans-serif;
  font-size: clamp(1.3rem, 2vw, 1.8rem);
  font-weight: 800;
  color: var(--text-dark);
  letter-spacing: -0.02em;
}

nav {
  display: flex;
  gap: 2rem;
  font-size: 0.95rem;
  font-weight: 500;
}

nav a {
  color: var(--text-muted);
  transition: color 0.3s ease;
}

nav a:hover {
  color: var(--accent-blue);
}

h1,
h2,
h3 {
  font-family: "Baloo 2", sans-serif;
  font-weight: 700;
  line-height: 1.1;
  margin: 0 0 0.5rem;
}

h1 {
  font-size: clamp(2.5rem, 5vw, 4rem);
  letter-spacing: -0.02em;
}

h2 {
  font-size: clamp(2rem, 3.5vw, 3rem);
  letter-spacing: -0.01em;
}

h3 {
  font-size: clamp(1.3rem, 2vw, 1.8rem);
}

p {
  margin: 0 0 1rem;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--accent-blue);
  margin-bottom: 0.5rem;
}

.lead {
  font-size: 1.1rem;
  color: var(--text-muted);
  max-width: 600px;
  line-height: 1.8;
}

.section-subtitle {
  font-size: 1.05rem;
  color: var(--text-muted);
  margin-top: 0.5rem;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.875rem 1.5rem;
  border-radius: 6px;
  font-weight: 600;
  font-size: 0.95rem;
  transition: all 0.3s ease;
  cursor: pointer;
  border: none;
  font-family: "Work Sans", sans-serif;
}

.button:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow);
}

.button.primary {
  background: var(--accent-blue);
  color: white;
}

.button.primary:hover {
  background: #1d4ed8;
}

.button.secondary {
  background: var(--bg-lighter);
  color: var(--text-dark);
  border: 2px solid var(--border-light);
}

.button.secondary:hover {
  border-color: var(--accent-blue);
  color: var(--accent-blue);
}

.hero {
  padding: 4rem 0;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.05) 0%, rgba(6, 182, 212, 0.05) 100%);
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 3rem;
  align-items: center;
}

.cta-row {
  display: flex;
  gap: 1rem;
  margin-top: 1.5rem;
  flex-wrap: wrap;
}

.hero-art img {
  border-radius: 12px;
  box-shadow: var(--shadow-lg);
  width: 100%;
}

.section {
  padding: 5rem 0;
}

.section.alt {
  background: var(--bg-lighter);
}

.section.cta-section {
  background: linear-gradient(135deg, var(--accent-blue) 0%, #1d4ed8 100%);
}

.section-heading {
  margin-bottom: 3rem;
}

.section-heading.center {
  text-align: center;
}

.section-heading h2 {
  color: var(--text-dark);
}

.signal-chain-graphic {
  margin: 2rem 0 3rem;
  overflow-x: auto;
  border-radius: 12px;
  background: white;
  padding: 1rem;
  box-shadow: var(--shadow);
}

.signal-chain-graphic img {
  width: 100%;
  height: auto;
}

.chain-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}

.chain-card {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1.5rem;
  background: white;
  border-radius: 8px;
  border: 2px solid var(--border-light);
  transition: all 0.3s ease;
  cursor: pointer;
}

.chain-card:hover {
  border-color: var(--accent-blue);
  box-shadow: var(--shadow);
  transform: translateY(-4px);
}

.chain-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  background: linear-gradient(135deg, var(--accent-orange) 0%, var(--accent-pink) 50%, var(--accent-teal) 100%);
  color: white;
  border-radius: 50%;
  font-family: "Baloo 2", sans-serif;
  font-size: 1.3rem;
  font-weight: 800;
}

.chain-card h3 {
  margin: 0;
}

.chain-card p {
  margin: 0;
  font-size: 0.95rem;
  color: var(--text-muted);
}

.book-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
}

.book-card {
  display: flex;
  flex-direction: column;
  border-radius: 12px;
  overflow: hidden;
  background: white;
  box-shadow: var(--shadow);
  transition: all 0.3s ease;
  cursor: pointer;
}

.book-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-lg);
}

.book-cover {
  height: 280px;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  padding: 2rem;
  position: relative;
  overflow: hidden;
}

.book-cover::before {
  content: "";
  position: absolute;
  inset: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="0.5"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
  opacity: 0.2;
}

.cover-text {
  position: relative;
  z-index: 1;
  color: white;
}

.cover-title {
  font-family: "Baloo 2", sans-serif;
  font-size: 1.8rem;
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 0.5rem;
}

.cover-subtitle {
  font-size: 0.9rem;
  font-weight: 500;
  opacity: 0.9;
}

.book-info {
  padding: 1.5rem;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
}

.book-info h3 {
  margin-top: 0;
  margin-bottom: 0.5rem;
}

.book-series {
  font-size: 0.85rem;
  color: var(--accent-blue);
  font-weight: 600;
  margin-bottom: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.book-description {
  flex-grow: 1;
  font-size: 0.95rem;
  color: var(--text-muted);
  margin-bottom: 1rem;
}

.book-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.tag {
  display: inline-block;
  background: var(--bg-lighter);
  color: var(--text-dark);
  font-size: 0.8rem;
  font-weight: 600;
  padding: 0.4rem 0.8rem;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.split {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 3rem;
  align-items: center;
}

.split > div:first-child p {
  font-size: 1.05rem;
  color: var(--text-muted);
  line-height: 1.8;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.stat {
  text-align: center;
  padding: 1.5rem;
  background: white;
  border-radius: 8px;
  box-shadow: var(--shadow-sm);
}

.stat strong {
  display: block;
  font-family: "Baloo 2", sans-serif;
  font-size: 2.5rem;
  color: var(--accent-blue);
  margin-bottom: 0.5rem;
}

.stat span {
  font-size: 0.9rem;
  color: var(--text-muted);
  font-weight: 500;
}

.cta-box {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  padding: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  color: white;
}

.cta-box h2 {
  color: white;
}

.cta-box .eyebrow {
  color: rgba(255, 255, 255, 0.85);
}

.cta-box .button.primary {
  background: white;
  color: var(--accent-blue);
  flex-shrink: 0;
}

.cta-box .button.primary:hover {
  background: var(--bg-light);
}

.site-footer {
  background: var(--text-dark);
  color: rgba(255, 255, 255, 0.7);
  padding: 2rem 0;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  gap: 2rem;
  font-size: 0.9rem;
}

.footer-inner p {
  margin: 0;
}

@media (max-width: 1024px) {
  .hero-inner,
  .split {
    grid-template-columns: 1fr;
  }

  .chain-cards {
    grid-template-columns: repeat(2, 1fr);
  }

  .cta-box {
    flex-direction: column;
    text-align: center;
  }
}

@media (max-width: 768px) {
  nav {
    gap: 1rem;
    font-size: 0.85rem;
  }

  .chain-cards {
    grid-template-columns: 1fr;
  }

  .stats {
    grid-template-columns: 1fr;
  }

  .footer-inner {
    flex-direction: column;
  }
}

@media (max-width: 600px) {
  .nav-wrapper {
    flex-direction: column;
    gap: 1rem;
  }

  nav {
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero {
    padding: 2rem 0;
  }

  .section {
    padding: 3rem 0;
  }

  .cta-row {
    flex-direction: column;
  }

  .button {
    width: 100%;
  }
}
