<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1620 640" width="1620" height="640" role="img" aria-labelledby="title desc">
  <title id="title">From sensor to data</title>
  <desc id="desc">A signal chain in four stages: a thermistor voltage divider (Analog Sensors), an op-amp buffer (Op-Amps), an ADC (Converters), and a serial link to a microcontroller (Digital Comms).</desc>

  <rect width="1620" height="640" fill="#ffffff"/>

  <g font-family="Nunito, 'Trebuchet MS', Helvetica, Arial, sans-serif" text-anchor="middle">
    <text x="810" y="62" font-size="42" font-weight="700" fill="#222">From sensor to data</text>
    <text x="810" y="96" font-size="22" fill="#555">Four little books, one signal chain</text>
  </g>

  <rect x="40"   y="120" width="340" height="460" rx="24" fill="#F5E6F7" stroke="#A733B2" stroke-width="4"/>
  <rect x="440"  y="120" width="340" height="460" rx="24" fill="#FAE5EF" stroke="#B33380" stroke-width="4"/>
  <rect x="840"  y="120" width="340" height="460" rx="24" fill="#E1F5F3" stroke="#33B2A7" stroke-width="4"/>
  <rect x="1240" y="120" width="340" height="460" rx="24" fill="#E5EDFB" stroke="#3A6FD8" stroke-width="4"/>

  <rect x="70"   y="140" width="280" height="44" rx="22" fill="#A733B2"/>
  <rect x="470"  y="140" width="280" height="44" rx="22" fill="#B33380"/>
  <rect x="870"  y="140" width="280" height="44" rx="22" fill="#33B2A7"/>
  <rect x="1270" y="140" width="280" height="44" rx="22" fill="#3A6FD8"/>

  <g font-family="Nunito, 'Trebuchet MS', Helvetica, Arial, sans-serif" font-size="22" font-weight="700" fill="#fff" text-anchor="middle">
    <text x="210"  y="170">1  Sensors</text>
    <text x="610"  y="170">2  Op-Amps</text>
    <text x="1010" y="170">3  Converters</text>
    <text x="1410" y="170">4  Digital Comms</text>
  </g>

  <g fill="none" stroke="#555" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M380 330 H432"/>
    <path d="M422 320 L436 330 L422 340"/>
    <path d="M780 330 H832"/>
    <path d="M822 320 L836 330 L822 340"/>
    <path d="M1180 330 H1232"/>
    <path d="M1222 320 L1236 330 L1222 340"/>
  </g>

  <g fill="none" stroke="#7D1F87" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="170" cy="222" r="7" fill="#F5E6F7"/>
    <path d="M170 229 V245"/>
    <rect x="158" y="245" width="24" height="60" fill="#F5E6F7"/>
    <path d="M170 305 V360"/>
    <rect x="158" y="360" width="24" height="60" fill="#F5E6F7"/>
    <path d="M146 432 L194 348"/>
    <path d="M170 420 V445"/>
    <path d="M148 445 H192"/>
    <path d="M157 454 H183"/>
    <path d="M166 463 H174"/>
    <path d="M170 330 H380"/>
  </g>
  <circle cx="170" cy="330" r="6" fill="#7D1F87"/>
  <g font-family="Nunito, 'Trebuchet MS', Helvetica, Arial, sans-serif" font-size="20" font-weight="700" fill="#7D1F87">
    <text x="190" y="227">+5 V</text>
    <text x="198" y="282">R</text>
    <text x="198" y="397">NTC</text>
  </g>

  <g fill="none" stroke="#8A1F5E" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M440 330 H480 V290 H520"/>
    <polygon points="520,250 520,410 680,330" fill="#FAE5EF"/>
    <path d="M680 330 H780"/>
    <path d="M710 330 V440 H490 V370 H520"/>
  </g>
  <circle cx="710" cy="330" r="6" fill="#8A1F5E"/>
  <g font-family="Nunito, 'Trebuchet MS', Helvetica, Arial, sans-serif" fill="#8A1F5E" text-anchor="middle">
    <text x="536" y="298" font-size="24" font-weight="700">+</text>
    <text x="536" y="378" font-size="24" font-weight="700">−</text>
    <text x="600" y="472" font-size="18" font-weight="600">Voltage follower</text>
  </g>

  <g fill="none" stroke="#1B7F76" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M840 330 H860"/>
    <polygon points="860,330 940,255 1160,255 1160,405 940,405" fill="#ffffff"/>
    <path d="M1160 330 H1180"/>
    <path d="M880 450 C890 422 905 422 915 450 S940 478 950 450" stroke-width="3"/>
    <path d="M968 450 H1034"/><path d="M1024 441 L1036 450 L1024 459"/>
    <path d="M1050 466 V434 H1075 V466 H1100 V434 H1125 V466 H1150" stroke-width="3"/>
  </g>
  <g font-family="Nunito, 'Trebuchet MS', Helvetica, Arial, sans-serif" font-weight="800" fill="#1B7F76" text-anchor="middle">
    <text x="930" y="338" font-size="20">IN</text>
    <text x="1030" y="345" font-size="38">ADC</text>
    <text x="1128" y="338" font-size="20">OUT</text>
  </g>

  <g fill="none" stroke="#2450A8" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M1240 330 H1330"/>
    <path d="M1277 342 L1293 318"/>
    <rect x="1330" y="250" width="190" height="160" rx="8" fill="#ffffff"/>
    <path d="M1360 230 V250"/><path d="M1400 230 V250"/><path d="M1440 230 V250"/><path d="M1480 230 V250"/>
    <path d="M1360 410 V430"/><path d="M1400 410 V430"/><path d="M1440 410 V430"/><path d="M1480 410 V430"/>
  </g>
  <g font-family="Nunito, 'Trebuchet MS', Helvetica, Arial, sans-serif" fill="#2450A8" text-anchor="middle">
    <text x="1285" y="302" font-size="17" font-weight="700">SPI / I²C</text>
    <text x="1425" y="343" font-size="38" font-weight="800">MCU</text>
  </g>
  <text x="1410" y="474" font-family="'Courier New', Courier, monospace" font-size="24" font-weight="700" fill="#2450A8" text-anchor="middle">1 0 1 1  0 1 0 0</text>

  <g font-family="Nunito, 'Trebuchet MS', Helvetica, Arial, sans-serif" text-anchor="middle">
    <g font-size="26" font-weight="800">
      <text x="210"  y="518" fill="#7D1F87">Measure</text>
      <text x="610"  y="518" fill="#8A1F5E">Clean up</text>
      <text x="1010" y="518" fill="#1B7F76">Convert</text>
      <text x="1410" y="518" fill="#2450A8">Send</text>
    </g>
    <g font-size="18" fill="#444">
      <text x="210"  y="550">Temperature becomes a voltage</text>
      <text x="610"  y="550">A buffer gives a stable signal</text>
      <text x="1010" y="550">The voltage becomes a number</text>
      <text x="1410" y="550">The number goes to a processor</text>
    </g>
    <text x="810" y="618" font-size="18" fill="#777">Big Subjects. Small Books. No Waffle.</text>
  </g>
</svg>




























































































































































































































































































































































































